# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from BotFather (@BotFather → /newbot)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# API ID and Hash from my.telegram.org (needed by the Local Bot API Server)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# URL of the Local Bot API Server (default matches docker-compose service name)
LOCAL_API_URL=http://telegram-bot-api:8081

# ── WordPress ─────────────────────────────────────────────────────────────
# Full URL of your WordPress site (no trailing slash)
WP_SITE_URL=https://blog.example.com

# WordPress username (the account that owns the Application Password)
WP_USER=admin

# Application Password: Users → Profile → Application Passwords → Add New
# Copy the generated password exactly (spaces included or removed — both work)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# publish | draft  — set to draft if you want to review before going live
WP_POST_STATUS=publish

# ── Audio compression (ffmpeg) ────────────────────────────────────────────
# Codec: libopus (recommended for voice) or libmp3lame (wider compatibility)
AUDIO_CODEC=libopus

# Bitrate: 32k–64k is ideal for mono spoken-word audio
AUDIO_BITRATE=48k

# Channels: 1 = mono (halves file size, no quality loss for lectures)
AUDIO_CHANNELS=1

# Output extension must match codec: opus → opus, libmp3lame → mp3
OUTPUT_EXT=opus
